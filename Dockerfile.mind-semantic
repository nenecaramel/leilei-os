# Dedicated Railway Memory semantic indexer. No changes to the existing
# production Alpine API, Native Live, Wake, iOS or Mac processes.
FROM node:22-bookworm-slim
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.9.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY tsconfig.json tsconfig.scripts.json ./
COPY src ./src
COPY scripts ./scripts
ENV HOME=/home/node
RUN mkdir -p /home/node/.cache/leileios && chown -R node:node /home/node /app
USER node
# Download and verify the existing quantized multilingual E5 once per image.
RUN pnpm mind:semantic-index:setup
ENV NODE_ENV=production PORT=3000
EXPOSE 3000
CMD ["pnpm","mind:semantic-index:worker"]
