ention-evaluator.test.ts tests/runtime-topic-resurface-thought-materialization.test.ts tests/runtime-topic-resurface-background-trigger.test.ts tests/runtime-topic-resurface-cadence.test.ts tests/runtime-topic-resurface-idle-opportunity.test.ts tests/runtime-topic-resurface-cross-device-opportunity.test.ts tests/runtime-topic-resurface-cross-device-coordinator.test.ts tests/topic-resurface-opportunity-config.test.ts tests/runtime-thought-mind-binding.test.ts tests/runtime-breath-governance.test.ts tests/runtime-breath-hybrid.test.ts tests/runtime-macos-natural-language-embedding.test.ts tests/runtime-local-e5-embedding.test.ts && pnpm --dir tools/claude-bridge test",
    "test:native-live-db": "RUN_NATIVE_LIVE_CONVERSATION_DATABASE_TEST=1 tsx --test tests/native-live-conversation-repository.integration.test.ts",
    "test:runtime-mind-db": "RUN_RUNTIME_MIND_DATABASE_TEST=1 tsx --test tests/runtime-subject-state-repository.integration.test.ts",
