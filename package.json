{
  "name": "leilei-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authenticated Leilei OS personal workspace API and Streamable HTTP MCP server.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/app/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/build-bridge-browser.mjs && node scripts/build-thinking-block-browser.mjs",
    "check:generated": "node scripts/build-bridge-browser.mjs --check && node scripts/build-thinking-block-browser.mjs --check && node scripts/generate-web-icons.mjs --check",
    "start": "node dist/app/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --import ./tests/register-css-loader.mjs --test --test-concurrency=1 tests/**/*.test.ts",
    "web:icons": "node scripts/generate-web-icons.mjs",
    "test:task-tag-integration": "RUN_DATABASE_INTEGRATION_TEST=1 tsx --test tests/task-tag-repository.integration.test.ts",
    "test:task-time-integration": "RUN_TASK_TIME_DATABASE_TEST=1 tsx --test tests/task-time-repository.integration.test.ts",
    "test:diary-search-integration": "RUN_DATABASE_INTEGRATION_TEST=1 tsx --test tests/diary-repository.integration.test.ts",
    "test:toy-integration": "RUN_TOY_DATABASE_INTEGRATION_TEST=1 tsx --test --test-reporter=spec tests/toy-command-repository.integration.test.ts",
    "test:mcp-write-idempotency-integration": "RUN_MCP_WRITE_IDEMPOTENCY_DATABASE_TEST=1 tsx --test --test-reporter=spec tests/mcp-write-idempotency.integration.test.ts",
    "test:bridge-integration": "RUN_BRIDGE_DATABASE_TEST=1 tsx --test --test-concurrency=1 tests/bridge-repository.integration.test.ts",
    "test:layout": "RUN_SAFARI_LAYOUT_TEST=1 tsx --test tests/native-date-layout.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:seed:phase2": "tsx scripts/seed-phase-2.ts",
    "e2e:native-live-canonical": "tsx scripts/native-live-canonical-e2e.ts",
    "test:native-live-minimal": "tsx --test tests/native-live-conversation-service.test.ts tests/native-live-conversation-orchestrator.test.ts tests/native-live-conversation-branch-orchestrator.test.ts tests/native-live-relay-contract.test.ts tests/bridge-dispatch-partition-contract.test.ts tests/native-live-relay-consumer.test.ts tests/native-live-runtime-protocol.test.ts tests/native-live-backend-turn-coordinator.test.ts tests/native-live-mac-runtime-executor.test.ts && pnpm --dir tools/claude-bridge test",
    "test:native-live-db": "RUN_NATIVE_LIVE_CONVERSATION_DATABASE_TEST=1 tsx --test tests/native-live-conversation-repository.integration.test.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "postgres": "^3.4.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.25.12",
    "jsdom": "^29.1.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@11.9.0"
}
