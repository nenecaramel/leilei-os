    "test:runtime-breath-db": "RUN_RUNTIME_BREATH_DATABASE_TEST=1 tsx --test tests/runtime-breath-recall-repository.integration.test.ts",
    "smoke:runtime-breath-embedding": "tsx scripts/runtime-breath-embedding-smoke.ts",
    "smoke:runtime-breath-embedding-calibration": "tsx scripts/runtime-breath-embedding-calibration.ts",
    "setup:runtime-breath-e5": "tsx scripts/setup-runtime-breath-e5.ts",
    "smoke:runtime-breath-e5-calibration": "tsx scripts/runtime-breath-e5-calibration.ts",
    "smoke:runtime-breath-e5-mind": "tsx scripts/runtime-breath-e5-mind-smoke.ts",
    "test:native-live-turn-db": "RUN_NATIVE_LIVE_TURN_DATABASE_TEST=1 tsx --test tests/native-live-backend-turn-repository.integration.test.ts",
    "test:native-live-relay-db": "RUN_NATIVE_LIVE_RELAY_DATABASE_TEST=1 tsx --test tests/native-live-backend-relay.integration.test.ts tests/native-live-background-model-queue.integration.test.ts",
    "runtime:native-live-mac-daemon": "tsx scripts/native-live-mac-daemon.ts",
    "test:native-live-http-db": "RUN_NATIVE_LIVE_HTTP_DATABASE_TEST=1 tsx --test tests/native-live-http-relay.integration.test.ts",
    "test:native-live-followup-db": "RUN_NATIVE_LIVE_MIND_FOLLOWUP_DATABASE_TEST=1 tsx --test tests/native-live-mind-followup.integration.test.ts",
    "test:native-live-semantic-db": "RUN_NATIVE_LIVE_SEMANTIC_DATABASE_TEST=1 tsx --test tests/native-live-semantic-handshake.integration.test.ts",
    "smoke:runtime-breath-e5-cross-device": "tsx scripts/runtime-breath-e5-cross-device-smoke.ts",
    "smoke:runtime-topic-resurface-production": "tsx scripts/runtime-topic-resurface-production-acceptance.ts",
    "test:runtime-thought-db": "RUN_RUNTIME_THOUGHT_DATABASE_TEST=1 tsx --test tests/runtime-thought-evolution-repository.integration.test.ts tests/runtime-topic-resurface-thought-materialization-repository.integration.test.ts tests/runtime-topic-resurface-background-pipeline.integration.test.ts tests/runtime-topic-resurface-cross-device-coordinator.integration.test.ts",
    "test:runtime-drive-db": "RUN_RUNTIME_DRIVE_DATABASE_TEST=1 tsx --test tests/runtime-drive-satisfaction-repository.integration.test.ts",
    "test:runtime-topic-db": "RUN_RUNTIME_TOPIC_DATABASE_TEST=1 tsx --test tests/runtime-topic-evolution-repository.integration.test.ts tests/runtime-curiosity-topic-projection-repository.integration.test.ts tests/runtime-topic-resurface-candidate-repository.integration.test.ts",
    "test:runtime-topic-resurface-eval": "tsx --test tests/runtime-topic-resurface-candidates.test.ts tests/runtime-topic-resurface-evaluation.test.ts tests/claude-code-topic-resurface-evaluator.test.ts tests/runtime-topic-resurface-internal-loop.test.ts tests/claude-code-topic-resurface-deliberator.test.ts tests/runtime-topic-resurface-retention-gate.test.ts tests/claude-code-topic-resurface-retention-evaluator.test.ts tests/runtime-topic-resurface-thought-materialization.test.ts tests/runtime-topic-resurface-background-trigger.test.ts",
    "test:runtime-topic-resurface-background": "tsx --test tests/runtime-topic-resurface-background-trigger.test.ts tests/runtime-topic-resurface-cadence.test.ts tests/runtime-topic-resurface-idle-opportunity.test.ts tests/runtime-topic-resurface-cross-device-opportunity.test.ts tests/runtime-topic-resurface-cross-device-coordinator.test.ts tests/topic-resurface-opportunity-config.test.ts tests/native-live-mac-daemon-loop.test.ts tests/native-live-background-model-protocol.test.ts tests/native-live-mac-background-model-executor.test.ts",
    "test:runtime-background-loops": "tsx --test tests/runtime-background-loop-orchestrator.test.ts tests/runtime-subject-state-background-maintenance.test.ts tests/runtime-distillation-background-trigger.test.ts tests/runtime-thought-mind-binding.test.ts tests/native-live-mind-followup.test.ts",
    "test:runtime-data-lifecycle": "tsx --test tests/runtime-data-lifecycle-contract.test.ts tests/data-retention-policy.test.ts tests/data-retention-coordinator.test.ts",
    "test:mcp-tool-surface": "tsx --test tests/mcp-tool-profiles.test.ts tests/mcp-production-tool-profiles.test.ts tests/mcp-tool-contract-governance.test.ts",
    "test:runtime-topic-opportunity-db": "RUN_RUNTIME_TOPIC_OPPORTUNITY_DATABASE_TEST=1 tsx --test tests/runtime-topic-resurface-cross-device-opportunity.integration.test.ts"
  },
