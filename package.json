    "build": "tsc -p tsconfig.json && node scripts/build-bridge-browser.mjs && node scripts/build-thinking-block-browser.mjs",
    "check:generated": "node scripts/build-bridge-browser.mjs --check && node scripts/build-thinking-block-browser.mjs --check && node scripts/generate-web-icons.mjs --check",
    "start": "node dist/app/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --import ./tests/register-css-loader.mjs --test --test-concurrency=1 tests/**/*.test.ts",
    "web:icons": "node scripts/generate-web-icons.mjs",
    "test:task-tag-integration": "RUN_DATABASE_INTEGRATION_TEST=1 tsx --test tests/task-tag-repository.integration.test.ts",
    "test:task-time-integration": "RUN_TASK_TIME_DATABASE_TEST=1 tsx --test tests/task-time-repository.integration.test.ts",
    "test:diary-search-integration": "RUN_DATABASE_INTEGRATION_TEST=1 tsx --test tests/diary-repository.integration.test.ts",
