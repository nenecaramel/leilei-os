PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL connection string. Railway injects this when a PostgreSQL service
# is linked to the application. Keep SSL settings in the URL when required by
# the database provider.
DATABASE_URL=

# Optional internal-only credential. It protects /internal/mcp and is not used
# by ChatGPT or the public /mcp OAuth flow.
MCP_AUTH_TOKEN=

# Single-user identity from the users table. The allowed Auth0 subject maps to
# this UUID on the server; clients can never submit a user ID.
MCP_USER_ID=

# Required only for the Phase 2 validation seed; choose explicitly and never
# infer this from source, channel, or provenance metadata.
SEED_CONTENT_AUTHOR=

# Public HTTPS origin without a trailing slash.
MCP_SERVER_URL=

# Auth0 OAuth configuration. AUTH0_AUDIENCE must exactly equal
# ${MCP_SERVER_URL}/mcp. The issuer must end with a slash.
AUTH0_ISSUER=https://your-tenant.auth0.com/
AUTH0_AUDIENCE=https://your-service.example.com/mcp
AUTH0_JWKS_URI=https://your-tenant.auth0.com/.well-known/jwks.json
AUTH0_REQUIRED_SCOPE=leilei:access
AUTH0_ALLOWED_SUBJECT=auth0|replace-with-user-id

# Optional Web API OAuth configuration. Configure all three values together to
# enable /api/v1. This audience and scope are separate from the MCP resource.
WEB_APP_ORIGIN=https://your-web-app.example.com
WEB_AUTH0_AUDIENCE=https://your-service.example.com/api
WEB_AUTH0_REQUIRED_SCOPE=leilei:web

# Optional Toy Command Queue bridge binding. USER_ID is the PostgreSQL users.id
# UUID (not an Auth0 sub). Both values are required to enable Toy routes.
# Generate the key from at least 32 cryptographically random bytes.
LEILEI_TOY_BRIDGE_KEY=
LEILEI_TOY_BRIDGE_USER_ID=
