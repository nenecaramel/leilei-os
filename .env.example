PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL connection string. Railway injects this when a PostgreSQL service
# is linked to the application. Keep SSL settings in the URL when required by
# the database provider.
DATABASE_URL=

# Optional internal-only credential. It protects /internal/mcp and is not used
# by ChatGPT or the public /mcp OAuth flow.
MCP_AUTH_TOKEN=

# Single-user identity from the users table. The allowed Auth0 subject maps to
# this UUID on the server; clients can never submit a user ID.
MCP_USER_ID=

# Optional Mac Native Live relay overrides. When omitted, the Mac daemon reuses
# MCP_SERVER_URL + MCP_AUTH_TOKEN. LISTENER_ID is also optional: the daemon
# derives a stable local UUID from this Mac so restarts retain lease identity.
LEILEI_NATIVE_LIVE_RELAY_URL=
LEILEI_NATIVE_LIVE_RELAY_TOKEN=
LEILEI_NATIVE_LIVE_LISTENER_ID=

# Cost guard for cloud-hosted periodic workers. Keep false on Railway Free:
# startup recovery remains one-shot, while Sentinel / native-live recovery
# polling / maintenance pulse timers stay off. Enable only deliberately.
LEILEI_CLOUD_PERIODIC_BACKGROUND_ENABLED=false

# Required only for the Phase 2 validation seed; choose explicitly and never
# infer this from source, channel, or provenance metadata.
SEED_CONTENT_AUTHOR=

# Public HTTPS origin without a trailing slash.
MCP_SERVER_URL=

# Auth0 OAuth configuration. AUTH0_AUDIENCE must exactly equal
# ${MCP_SERVER_URL}/mcp. The issuer must end with a slash.
AUTH0_ISSUER=https://your-tenant.auth0.com/
AUTH0_AUDIENCE=https://your-service.example.com/mcp
AUTH0_JWKS_URI=https://your-tenant.auth0.com/.well-known/jwks.json
AUTH0_REQUIRED_SCOPE=leilei:access
AUTH0_ALLOWED_SUBJECT=auth0|replace-with-user-id

# Optional local OAuth authorization adapter. It is disabled by default so the
# existing Auth0 Authorization Server remains the ChatGPT OAuth path. When
# enabled, the Auth0 application must be a public PKCE client and its callback
# must be registered at OAUTH_AS_UPSTREAM_REDIRECT_URI.
OAUTH_AS_ENABLED=false
OAUTH_AS_UPSTREAM_CLIENT_ID=
OAUTH_AS_UPSTREAM_REDIRECT_URI=https://your-service.example.com/oauth/callback
# Comma-separated exact CIMD client_id URLs. Leaving this unset uses the
# fail-closed initial allowlist for Claude; setting it to an empty value allows
# no dynamic CIMD clients.
# OAUTH_CIMD_TRUSTED_CLIENT_IDS=https://claude.ai/oauth/mcp-oauth-client-metadata
OAUTH_CIMD_FETCH_TIMEOUT_MS=5000
# Required when OAUTH_AS_ENABLED=true: JSON array containing the existing
# ChatGPT static client metadata. The adapter refuses to start without it.
# Keep the production ChatGPT authentication method and JWKS metadata exact;
# do not downgrade a private_key_jwt client to none.
# OAUTH_STATIC_CLIENTS_JSON='[{"client_id":"<CHATGPT_CLIENT_ID>","client_name":"ChatGPT","redirect_uris":["<CHATGPT_REDIRECT_URI>"],"token_endpoint_auth_method":"private_key_jwt","token_endpoint_auth_methods_supported":["none","private_key_jwt"],"token_endpoint_auth_signing_alg":"RS256","jwks_uri":"https://<CHATGPT_JWKS_HOST>/oauth/jwks.json"}]'

# Optional Web API OAuth configuration. Configure all three values together to
# enable /api/v1. This audience and scope are separate from the MCP resource.
WEB_APP_ORIGIN=https://your-web-app.example.com
WEB_AUTH0_AUDIENCE=https://your-service.example.com/api
WEB_AUTH0_REQUIRED_SCOPE=leilei:web

# Optional Toy Command Queue bridge binding. USER_ID is the PostgreSQL users.id
# UUID (not an Auth0 sub). Both values are required to enable Toy routes.
# Generate the key from at least 32 cryptographically random bytes.
LEILEI_TOY_BRIDGE_KEY=
LEILEI_TOY_BRIDGE_USER_ID=

# Optional iPhone Shortcut Health v2 sync binding. USER_ID is the PostgreSQL
# users.id UUID (not an Auth0 sub). Both values are required to enable sync.
# Generate the dedicated key from at least 32 cryptographically random bytes.
LEILEI_HEALTH_SYNC_KEY=
LEILEI_HEALTH_SYNC_USER_ID=

# Optional server-only Notion Personal Access Token for the production MCP
# Notion read tools plus the explicit write_notion_page and
# write_notion_comment surface. Grant only the Notion capabilities required by
# those operations. Never expose it to the Web app, MCP tool inputs/outputs,
# logs, or source control.
NOTION_PAT=

# Optional MCP session/idempotency governance. Safe defaults are used when
# omitted; values are process-local (not a cross-replica global limit).
MCP_SESSION_IDLE_TTL_SECONDS=7200
MCP_SESSION_ABSOLUTE_TTL_SECONDS=86400
MCP_SESSION_MAX_PER_USER=8
MCP_SESSION_MAX_TOTAL=32
MCP_IDEMPOTENCY_RETENTION_DAYS=30
MCP_IDEMPOTENCY_CLEANUP_INTERVAL_HOURS=24
