PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL connection string. Railway injects this when a PostgreSQL service
# is linked to the application. Keep SSL settings in the URL when required by
# the database provider.
DATABASE_URL=

# Optional during Phase 1. When set, /mcp requires:
# Authorization: Bearer <value>
MCP_AUTH_TOKEN=

# Phase 2 single-user identity. This must be a UUID from the users table once
# the Phase 2 schema is introduced.
MCP_USER_ID=

# Set this after deployment, for example:
# https://mcp.example.com/mcp
MCP_SERVER_URL=
