{
  "name": "leilei-os-web",
  "version": "0.1.0",
  "private": true,
  "description": "Authenticated Leilei OS Web workspace for Diary, Todo, Day Space, Conversations, Universe, Search, and System data.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vite-plugin-pwa": "1.3.0",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "allowScripts": {
    "browser-tabs-lock@1.3.0": true,
    "esbuild@0.28.1": true
  }
}
