# Copy to ~/.claude/leileios-mind/mind.env, chmod 600, then fill privately.
# This is the Railway origin, without /mcp or /internal/mind/recall.
LEILEI_MIND_RECALL_URL=https://leilei-os-production.up.railway.app
# Use the existing NATIVE_LIVE_RELAY_AUTH_TOKEN. Never commit a real value.
LEILEI_MIND_RECALL_TOKEN=
# Canonical client name already used by tools/claude-bridge.
LEILEI_MIND_MCP_SERVER_NAME=leileios
# Optional; defaults to ~/.leileios/claude-code-mind/semantic.sock.
LEILEI_MIND_SEMANTIC_SOCKET=
