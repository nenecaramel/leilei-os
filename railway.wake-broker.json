{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.wake-broker",
    "watchPatterns": [
      "cmd/native-live-wake-broker/**",
      "Dockerfile.wake-broker",
      "railway.wake-broker.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ALWAYS",
    "sleepApplication": false
  }
}
